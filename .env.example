# Copiar este archivo como .env y ajustar.

# Puerto del servidor
PORT=3000

# 127.0.0.1 = solo este computador.
# 0.0.0.0   = accesible desde celulares en la misma red (definir API_TOKEN).
HOST=127.0.0.1

# Ruta de la base de datos SQLite y de las fotos/adjuntos
DB_PATH=./data/cafe.db
UPLOADS_DIR=./data/uploads

# Si se define, todas las rutas /api exigen el encabezado
#   Authorization: Bearer <API_TOKEN>
# Esta es la clave COMPARTIDA: deja entrar, pero no deja nombre en los registros.
API_TOKEN=

# Una clave por persona. Con estas, el sistema marca quién registró cada lote,
# proceso, venta y gasto, en el campo "registrado_por" (lo pone el servidor, no
# se escribe a mano ni se puede cambiar después).
#   USUARIOS=Nombre:clave,Otro:clave
# El nombre es el que queda en los registros. Conviven con API_TOKEN; cuando
# todos tengan su clave propia, borre API_TOKEN para que nada quede sin nombre.
USUARIOS=

# Zona horaria usada para sincronizar clima
TIMEZONE=America/Bogota

# Monitoreo automático: cada cuántas horas sincronizar el clima de Open-Meteo
# y recalcular los riesgos agroclimáticos (0 = desactivado)
CLIMA_AUTO_HORAS=3
